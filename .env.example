# Copy to `.env` in the same directory as this repo (`cp .env.example .env`).
# Mossy loads `.env` automatically via `mossy.env.load_mossy_env()` (see `main.py` / `mossy/main.py`).

# -----------------------------------------------------------------------------
# Mossy settings (read with os.getenv in code)
# -----------------------------------------------------------------------------

# Interactive CLI chat model (defaults to PLATFORMER_SKILL_MODEL if unset).
PLATFORMER_CLI_MODEL=

# Skill worker (chat LLM; constructed lazily on first executed task).
PLATFORMER_SKILL_MODEL=openai:gpt-5.4-mini

# Non-empty: disables think_next (follow-ups and idle housekeeping).
PLATFORMER_DISABLE_AUTONOMOUS=

# Optional: goal string for a single IDLE housekeeping task after non-idle work (never chains IDLE→IDLE).
PLATFORMER_IDLE_GOAL=

# Non-empty: disable the duty sentinel loop (clock-driven jobs).
PLATFORMER_DISABLE_DUTIES=

# How many work loops pop the queue at once. Above 1, skills and duties must not rely on
# running one at a time.
PLATFORMER_WORKER_CONCURRENCY=1

# Comma-separated skills (and the capabilities gated on them) the queued worker does not get,
# e.g. shell,filesystem. It runs with nobody reading along.
PLATFORMER_WORKER_EXCLUDE_SKILLS=

# Seconds allowed for one run_skill_script call.
SKILL_SCRIPT_TIMEOUT_SECONDS=90

# Trusted-terminal chat history bound, in messages.
CLI_HISTORY_MAX_MESSAGES=200

# Limit skills to named callers: "skill=id,id;other=id". Slack ids and Teams AAD object ids.
# An unnamed skill is open; a named skill with no ids is denied to every chat caller.
MOSSY_SKILL_ACCESS=

# Skill options per chat channel. Replace SLACK with TEAMS, MCP or AGUI.
# Comma-separated skills this channel may use (default: all).
SLACK_ALLOW_SKILLS=
# true: put each SKILL.md in the instructions and only allow run_skill_script. Faster replies;
# use with a short allow list.
SLACK_DIRECT_SCRIPTS=
# Cap for result-count script arguments (n, limit, top_k, max_results).
SLACK_MAX_SCRIPT_RESULTS=

# Daily queue digest (user duty duties/ops_digest.py + skill skills/ops-digest/). Ships inert.
OPS_DIGEST_ENABLED=false
OPS_DIGEST_HOUR_UTC=13

# HTTP bind (FastAPI / uvicorn).
PLATFORMER_HOST=127.0.0.1
PORT=8765
# Optional bearer key for protected HTTP endpoints (/run, /queue, /agui, /files, /mcp).
MOSSY_API_KEY=

# AG-UI web chat channel (SSE). Enabled with HTTP unless you pass --no-agui.
# POST endpoint path (default /agui). Set AGUI_CORS_ORIGINS for browser clients.
PLATFORMER_AGUI_MODEL=
AGUI_PATH=/agui
AGUI_CORS_ORIGINS=

# MCP channel (Streamable HTTP). Enabled with HTTP unless you pass --no-mcp.
# Connect Claude Desktop/Code to http://127.0.0.1:8765/mcp — tool: ask_mossy.
PLATFORMER_MCP_MODEL=
MCP_PATH=/mcp
MCP_HISTORY_TTL_SECONDS=7200
MCP_HISTORY_MAX_CONVERSATIONS=500
MCP_HISTORY_MAX_MESSAGES=40
# Extra Host/Origin values for DNS rebinding protection (comma-separated).
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_DISABLE_DNS_REBINDING=1

# Slack Socket Mode channel.
# SLACK_BOT_TOKEN is the bot OAuth token from "OAuth & Permissions" (xoxb-...).
# SLACK_APP_TOKEN is the app-level token with connections:write from "Socket Mode" (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional Slack model/history controls.
PLATFORMER_SLACK_MODEL=
SLACK_HISTORY_TTL_SECONDS=7200
SLACK_HISTORY_MAX_CONVERSATIONS=500
SLACK_HISTORY_MAX_MESSAGES=40

# Non-empty: log every incoming Slack event type to the terminal (verbose).
SLACK_DEBUG=

# A2A channel (/a2a). Needs MOSSY_API_KEY: without it every task request is refused.
PLATFORMER_A2A_MODEL=
MOSSY_A2A_NAME=mossy
MOSSY_A2A_DESCRIPTION=
# Extra tools: comma-separated package.module:function. Keep them read-only.
MOSSY_A2A_TOOLS=

# Microsoft Teams channel. Needs pip install -r requirements-teams.txt and both credentials.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
TEAMS_PATH=/api/messages
PLATFORMER_TEAMS_MODEL=
TEAMS_HISTORY_TTL_SECONDS=7200
TEAMS_HISTORY_MAX_CONVERSATIONS=500
TEAMS_HISTORY_MAX_MESSAGES=40
TEAMS_TYPING_PERIOD_SECONDS=2.5

# Public origin of this agent: absolute /files links in Teams and the A2A card's URL.
MOSSY_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Integrations (capabilities). Each is gated on its skill and is simply absent
# when unconfigured, so Mossy still boots without these set.
# -----------------------------------------------------------------------------

# Freshdesk (capability: freshdesk).
# FRESHDESK_API_KEY is the Basic-auth value sent verbatim as `Authorization: Basic <value>`
# (base64 of "<api_key>:X"), matching existing Mossy/Freshdesk deployments.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Jira Cloud (capability: jira).
# JIRA_SITE is the Atlassian hostname, e.g. vossmoos.atlassian.net
# JIRA_SPACE_NAME is the project key, e.g. VM
# JIRA_USER_EMAIL + JIRA_API_KEY are used for Basic auth (email:api_token).
JIRA_SITE=
JIRA_SPACE_NAME=
JIRA_USER_EMAIL=
JIRA_API_KEY=
# Jira webhook channel (POST /webhooks/jira by default). Auth is Jira's X-Hub-Signature
# HMAC (sha256=<hex>) over the raw JSON body — not MOSSY_API_KEY. Set JIRA_WEBHOOK_SECRET
# to the same secret configured in Jira when the webhook was created.
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_PATH=
# Only enqueue when changelog has status -> this value (default For Test).
JIRA_WEBHOOK_TRIGGER_STATUS=For Test

# GitHub (capability: github). PAT with repo + pull-request scopes.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional: override the hosted GitHub MCP endpoint.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# Optional: base directory for local clones (default: ./repos under the working dir).
GITHUB_WORKDIR=
# Commit author/committer for git_commit_all (defaults shown).
MOSSY_GIT_USER_NAME=mossy-mossy
MOSSY_GIT_USER_EMAIL=services@vossmoos.com

# Filesystem (capability: filesystem). Root for read/write/append and zip/unzip.
# Defaults to the repo root when unset.
MOSSY_FS_ROOT=
# Max bytes accepted in a single write_file/append_file call. Default: 5MB.
MOSSY_FS_MAX_WRITE=

# File sharing (capability: file-sharing). Isolated folder behind the protected
# /files download endpoint; share_file copies finished files here.
# Defaults to <repo>/shared when unset.
MOSSY_SHARE_ROOT=
# Max total storage under the share root before a new share is refused.
# Accepts bytes or suffixes like 100MB / 1GB. Default: 100MB.
MOSSY_SHARE_MAX_STORAGE=

# Skill manager (capability: skill-manager). Source repository the CLI
# "install skill <name>" command clones skills from. Point this at your own repo
# (public or private) to use your own skill catalog. Private repos authenticate
# with GITHUB_PERSONAL_ACCESS_TOKEN (set above). Default: the public sample repo.
MOSSY_SKILLS_REPO=https://github.com/vossmoos/mossy-skills
# Optional branch/tag/commit to fetch skills from (default: the repo's default branch).
MOSSY_SKILLS_REPO_REF=

# External MCP servers (capability: mcp, skill: mcp). E.g. Myco: permissioned SaaS tools and
# company memory behind one endpoint. Comma-separate several names; each needs a URL.
MOSSY_MCP_SERVERS=
# MOSSY_MCP__MYCO__URL=http://myco:8080/mcp
# MOSSY_MCP__MYCO__TOKEN=            # this agent's Myco key, sent as Authorization: Bearer
# MOSSY_MCP__MYCO__HEADERS=          # extra headers as JSON, e.g. {"X-Tenant": "acme"}
# MOSSY_MCP__MYCO__TOOL_PREFIX=      # prefix tool names to avoid collisions
# MOSSY_MCP__MYCO__SKILL=mcp         # the skill that gates these tools
# MOSSY_MCP__MYCO__TIMEOUT=30

# -----------------------------------------------------------------------------
# Provider API keys — OpenAI is required for the defaults above.
# -----------------------------------------------------------------------------

OPENAI_API_KEY=
